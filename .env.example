# =============================================================================
# AI Video Agent - Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# =============================================================================

# ── Application Environment ──────────────────────────────────────────────────
# Options: development, staging, production
ENVIRONMENT=development

# Comma-separated frontend origins. Do not use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable debug mode (true/false) - automatically disabled in production
DEBUG=false

# ── Logging Configuration ────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_FILE_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ── File Upload Configuration ────────────────────────────────────────────────
# Maximum file size for uploads (in MB)
MAX_UPLOAD_SIZE_MB=500

# Temporary directory for uploaded files
TEMP_UPLOAD_DIR=temp

# ── Audio Processing ─────────────────────────────────────────────────────────
DOWNLOAD_DIR=downloads
CHUNK_MINUTES=10
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
MAX_FILE_SIZE_MB=2000  # Max 2000MB (2GB) - validator limit

# ── Whisper Configuration (Local Transcription) ──────────────────────────────
# Model options: tiny, base, small, medium, large, large-v2, large-v3
# Smaller models are faster but less accurate
# Speed comparison for 10-min video:
#   tiny:   ~1-2 min (85-90% accuracy)
#   base:   ~2-3 min (90-92% accuracy)
#   small:  ~3-5 min (95% accuracy) ← RECOMMENDED
#   medium: ~8-12 min (97-98% accuracy)
#   large:  ~15-20 min (98-99% accuracy)
WHISPER_MODEL=small

# Device options: auto, cpu, cuda
# auto = Automatically use CUDA if GPU available, else CPU (RECOMMENDED)
# cpu  = Force CPU usage
# cuda = Force GPU usage (requires NVIDIA GPU with CUDA)
# GPU acceleration provides 10-50x speed improvement!
WHISPER_DEVICE=auto

# Compute type options: int8, int16, float16, float32
# int8 = Fastest, lowest memory, good quality (recommended for CPU)
# float16 = Fast, used automatically for CUDA
# float32 = Slowest, highest memory, best quality
WHISPER_COMPUTE_TYPE=int8

# ── Sarvam AI Configuration (Hinglish Transcription) ─────────────────────────
# Required only if you want to support Hinglish transcription
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TIMEOUT=120
SARVAM_MAX_RETRIES=3

# ── Mistral AI Configuration (LLM Operations) ────────────────────────────────
# REQUIRED - Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.3
MISTRAL_MAX_TOKENS=4096
MISTRAL_TIMEOUT=60
MISTRAL_MAX_RETRIES=3

# ── Vector Store Configuration (RAG) ─────────────────────────────────────────
VECTOR_DB_DIR=vector_db
VECTOR_COLLECTION_NAME=meeting_transcript
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=50
VECTOR_RETRIEVER_K=4

# =============================================================================
# SECURITY NOTES:
# - Replace all placeholder values with your actual API keys
# - Keep your .env file secure and never share it
# - Use different API keys for development, staging, and production
# - Rotate API keys regularly for security
# =============================================================================




# ── Supabase Configuration (Optional - for cloud file storage) ──────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
# If not provided, files will be stored locally only (deleted after processing)
# With Supabase: Files are permanently stored and accessible via public URLs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_KEY=your_service_key_here  # Optional, for admin operations
